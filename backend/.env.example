# ============================================================
#  Enterprise AI Quant System — Environment Configuration
# ============================================================
#  Copy this file to .env and fill in your values.
#  Never commit the real .env file to version control.
# ============================================================

# ─── Application ────────────────────────────────────────────
QUANT_ENVIRONMENT=development        # development | production
QUANT_MODE=paper                     # paper | live (live blocked in dev)
QUANT_DEBUG=false
QUANT_HOST=0.0.0.0
QUANT_PORT=8000

# ─── Security ───────────────────────────────────────────────
QUANT_AUTH_ENABLED=true
QUANT_AUTH_SECRET=change-me-to-a-32-char-random-string!
QUANT_AUTH_ADMIN_USERNAME=admin
QUANT_AUTH_ADMIN_PASSWORD=change-me-12chars-min
QUANT_FORCE_HTTPS=false               # true in prod (behind TLS terminator)
QUANT_ALLOWED_HOSTS=["localhost","api.example.com"]
QUANT_CORS_ORIGINS=["http://localhost:5173","https://app.example.com"]

# ─── Database (PostgreSQL) ──────────────────────────────────
QUANT_STORAGE_ENABLED=true
QUANT_STORAGE_BACKEND=postgres
QUANT_POSTGRES_DSN=postgresql://quant:quant@localhost:5432/quant

# ─── Redis ─────────────────────────────────────────────────
QUANT_REDIS_URL=redis://localhost:6379/0
QUANT_EVENT_BACKEND=redis
QUANT_EVENT_STREAM=quant.domain.events

# ─── Observability ─────────────────────────────────────────
QUANT_LOG_LEVEL=INFO
QUANT_LOG_FORMAT=json                  # json | text
QUANT_LOG_FILE=                        # empty = stdout
QUANT_METRICS_ENABLED=true
QUANT_METRICS_AUTH_ENABLED=true
QUANT_OTEL_ENABLED=false
QUANT_OTEL_ENDPOINT=http://localhost:4317
QUANT_OTEL_SERVICE_NAME=quant-system
QUANT_SENTRY_DSN=

# ─── Rate Limiting ────────────────────────────────────────
QUANT_RATE_LIMIT_ENABLED=true
QUANT_RATE_LIMIT_RPM=120
QUANT_RATE_LIMIT_BURST=20

# ─── API Key Auth ──────────────────────────────────────────
QUANT_API_KEY_ENABLED=false

# ─── Strategy Scheduler ────────────────────────────────────
QUANT_STRATEGY_SCHEDULER_ENABLED=false
QUANT_STRATEGY_SCHEDULER_INTERVAL_SECONDS=300

# ─── Market Data ───────────────────────────────────────────
QUANT_MARKET_DATA_MODE=mock           # mock | public
QUANT_MARKET_REFRESH_SECONDS=15

# ─── Celery (Async Tasks) ──────────────────────────────────
QUANT_ENABLE_CELERY=false
QUANT_CELERY_BROKER_URL=redis://localhost:6379/1
QUANT_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── PostgreSQL (docker-compose) ──────────────────────────
POSTGRES_DB=quant
POSTGRES_USER=quant
POSTGRES_PASSWORD=quant_strong_password_here
